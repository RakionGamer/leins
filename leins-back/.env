PORT=3000
NODE_ENV=production
SEQ_LOG=false
DB_SYNC=false          
PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=lein
DB_PORT=3306
JWT_ACCESS_SECRET=super_access_secret
JWT_REFRESH_SECRET=super_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
TZ=America/Santiago
REFRESH_RETENTION_DAYS=60    # cuantos dias mantener tokens expirados o revocados
REFRESH_MARK_EXPIRED=true    # si true, marca como revocados los que ya expiraron
REFRESH_REPLAY_LOOKBACK_DAYS=30   # ventana para buscar refresh revocados que puedan reusarse
MAX_ACTIVE_SESSIONS=2 # maximo de sessiones permitidas
CORS_ORIGIN=https://app.leinsadvisor.cl,http://app.leinsadvisor.cl,http://localhost:3000
CORS_ORIGIN_DEV=https://app.leinsadvisor.cl,http://app.leinsadvisor.cl,http://localhost:3000
MYSQL_AES_KEY=dev_only_key_cambia_esto
ACTIVE_STATE_ID=1